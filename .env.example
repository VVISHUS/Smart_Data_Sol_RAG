# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# WHY a committed .example file: a reviewer cloning this repo needs to know
# exactly which variables exist without reading the source. This is the
# self-documenting contract for the runtime environment.
# ---------------------------------------------------------------------------

# Required when LLM_PROVIDER=google (the default).
GOOGLE_API_KEY=your-key-here

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Overrides config.yaml -> llm.provider. Accepts: google | openai
# WHY env can override YAML: config.yaml holds committed defaults that describe
# the *intended* setup; the environment holds machine-specific reality.
LLM_PROVIDER=google
